{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Storytelling FigureSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "claim",
    "visualType",
    "entities",
    "relations",
    "constraints"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "claim": {
      "type": "string",
      "minLength": 4
    },
    "focus": {
      "type": "string",
      "minLength": 2
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "callout": {
      "type": "string"
    },
    "caution": {
      "type": "string"
    },
    "visualType": {
      "type": "string",
      "enum": [
        "scene",
        "pipeline",
        "threshold",
        "distribution",
        "role-loop",
        "comparison",
        "layer",
        "version",
        "matrix"
      ]
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "role"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "minNodeGap",
        "textPadding",
        "minLinkGap",
        "allowEdgeCrossing"
      ],
      "properties": {
        "direction": {
          "type": "string",
          "enum": ["left-to-right", "right-to-left", "top-to-bottom", "center-out"]
        },
        "minNodeGap": {
          "type": "number",
          "minimum": 16
        },
        "textPadding": {
          "type": "number",
          "minimum": 8
        },
        "minLinkGap": {
          "type": "number",
          "minimum": 8
        },
        "allowEdgeCrossing": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "evidence": {
      "type": "string"
    },
    "boundary": {
      "type": "string"
    }
  }
}
